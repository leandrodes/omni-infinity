<div class="field-unit__label">
  <label>Limites</label>
</div>
<div class="field-unit__field">
  <%
    labels = {
      'max_users' => 'Máximo de Usuários',
      'max_inboxes' => 'Máximo de Caixas de Entrada'
    }
  %>
  <% JSON.parse(field.to_s).each do |key, val| %>
    <div class="flex items-center gap-3 mb-3">
      <label class="w-56 text-sm text-slate-700"><%= labels[key] || key %></label>
      <%= number_field "account[limits]", key, value: val, min: 0, placeholder: 'Ilimitado', class: "rounded border-slate-300" %>
    </div>
  <% end %>
  <p class="text-xs text-slate-500">
    Deixe em branco para ilimitado. O valor 0 também é tratado como ilimitado.
  </p>
</div>
