<div class="field-unit__label">
  <label>Funcionalidades e Recursos de IA</label>
</div>
<div class="field-unit__field feature-container">
  <%
    display_names = SuperAdmin::AccountFeaturesHelper.feature_display_names
  %>

  <h3 class="mb-3 text-sm font-semibold text-slate-700">Funcionalidades</h3>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% SaasFeaturesField::FUNCTIONALITY_FEATURES.each do |feature_key| %>
      <% val = field.data[feature_key] %>
      <div class="flex items-center justify-between p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
        <span class="text-sm text-slate-700"><%= display_names[feature_key] || feature_key %></span>
        <span><%= check_box "enabled_features", "feature_#{feature_key}", { checked: val, class: "h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600" }, true, false %></span>
      </div>
    <% end %>
  </div>

  <h3 class="mt-8 mb-3 text-sm font-semibold text-slate-700">Recursos de IA</h3>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% SaasFeaturesField::AI_FEATURES.each do |feature_key| %>
      <% val = field.data[feature_key] %>
      <div class="flex items-center justify-between p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
        <span class="text-sm text-slate-700"><%= display_names[feature_key] || feature_key %></span>
        <span><%= check_box "enabled_features", "feature_#{feature_key}", { checked: val, class: "h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600" }, true, false %></span>
      </div>
    <% end %>

    <div class="flex items-center justify-between gap-3 p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
      <span class="text-sm text-slate-700">Transcrição de Áudio</span>
      <span class="flex-shrink-0">
        <%= hidden_field_tag 'account[transcription_allow_system]', '0' %>
        <%= check_box_tag 'account[transcription_allow_system]', '1', f.object.transcription_allow_system,
              class: 'h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600' %>
      </span>
    </div>
  </div>

  <hr class="my-8 shadow-sm outline outline-1 outline-n-container">

  <h3 class="mb-3 text-sm font-semibold text-slate-700">Outras funcionalidades</h3>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% field.other_features.each do |key_array, val| %>
      <% feature_key, display_name = key_array %>
      <div class="flex items-center justify-between p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
        <span class="text-sm text-slate-700"><%= field.label_for(feature_key, display_name) %></span>
        <span>
          <%= check_box "enabled_features", "feature_#{feature_key}",
                { checked: val, class: "h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600" }, true, false %>
        </span>
      </div>
    <% end %>
  </div>
</div>
