<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chatbot · <%= @account.name %></title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body { margin: 0; display: flex; flex-direction: column; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f6f7f9; color: #1f2937; }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 22px; background: #fff; border-bottom: 1px solid #e5e7eb; }
    .topbar h1 { font-size: 16px; margin: 0; font-weight: 650; }
    .topbar p { margin: 3px 0 0; color: #6b7280; font-size: 12px; }
    .topbar-actions { display: flex; align-items: center; gap: 18px; }
    .topbar a { color: #4f46e5; text-decoration: none; font-size: 13px; font-weight: 600; }
    .frame { flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .frame iframe { flex: 1; min-height: 0; width: 100%; border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; }
    .notice { padding: 10px 12px; border-radius: 8px; background: #ecfdf5; color: #065f46; font-size: 12px; }
    .alert { padding: 10px 12px; border-radius: 8px; background: #fef2f2; color: #991b1b; font-size: 12px; word-break: break-word; }
    .empty { flex: 1; display: flex; align-items: center; justify-content: center; color: #6b7280; font-size: 13px; }
    .source { font-size: 11px; color: #6b7280; line-height: 1.5; }
  </style>
</head>
<body>
  <header class="topbar">
    <div>
      <h1>Chatbot · <%= @account.name %></h1>
      <p>Chatbot 2.28.2 · workspace da conta</p>
    </div>
    <nav class="topbar-actions">
      <a href="<%= bot_builder_documentation_path(account_id: @account.id) %>">Documentação</a>
      <a href="/app/accounts/<%= @account.id %>/dashboard">Voltar para o Omni-Channel Infinity</a>
    </nav>
  </header>

  <main class="frame">
    <% if flash[:notice].present? %>
      <div class="notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="alert"><%= flash[:alert] %></div>
    <% end %>
    <% if @error.present? %>
      <div class="alert">
        <strong>Chatbot indisponível</strong><br>
        <%= @error %>
      </div>
    <% end %>

    <% if @typebot_url.present? %>
      <iframe src="<%= @typebot_url %>" title="Editor do Chatbot" allow="clipboard-read; clipboard-write"></iframe>
    <% else %>
      <div class="empty">O editor será exibido quando o Chatbot estiver disponível.</div>
    <% end %>
  </main>

  <div class="source" style="padding: 0 16px 12px;">
    Chatbot 2.28.2 · Software livre licenciado sob AGPLv3.
    <a href="/downloads/chatbot-source-2.28.2.tar.gz">Código-fonte desta instalação</a>
    · <a href="<%= bot_builder_licenses_path(account_id: @account.id) %>">Licenças</a>
  </div>
</body>
</html>
