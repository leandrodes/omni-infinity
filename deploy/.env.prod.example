# Omni-Channel Infinity (Production)
# Tag da imagem customizada no GHCR (latest, v1.0.0, sha-xxxx). Veja GitHub > Packages.
OMNI_IMAGE_TAG=latest
FRONTEND_URL=https://app.seudominio.com.br
HELPCENTER_URL=
SECRET_KEY_BASE=GENERE_VIA_INSTALL
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=GENERE_VIA_INSTALL
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=GENERE_VIA_INSTALL
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=GENERE_VIA_INSTALL

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=GENERE_VIA_INSTALL

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=GENERE_VIA_INSTALL
POSTGRES_DATABASE=chatwoot

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false

# Storage
ACTIVE_STORAGE_SERVICE=local

# SMTP (configure conforme sua necessidade)
SMTP_ADDRESS=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=app.seudominio.com.br
MAILER_SENDER_EMAIL=Omni <no-reply@seudominio.com.br>
SMTP_OPENSSL_VERIFY_MODE=peer

# Logs
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Push relay
ENABLE_PUSH_RELAY_SERVER=true
